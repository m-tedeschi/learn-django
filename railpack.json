{
  "$schema": "https://schema.railpack.com",
  "packages": {
    "node": "22"
  },
  "steps": {
    "build": {
      "commands": [
        "...",
        "cd frontend && npm ci",
        "cd frontend && npm run build",
        "python manage.py collectstatic --noinput"
      ]
    }
  },
  "deploy": {
    "startCommand": "python manage.py migrate && gunicorn --bind 0.0.0.0:${PORT:-8000} config.wsgi:application"
  }
}
